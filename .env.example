# Optional: enables a shared live queue across phones and laptops.
# Use only the public project URL and anon key. Never put a service-role key in a Vite variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional only. The app uses the interactive OpenStreetMap map by default,
# so a Google Maps key is not necessary for the school presentation.
VITE_GOOGLE_MAPS_API_KEY=
